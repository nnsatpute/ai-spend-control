# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_spend_control?schema=public"

# openssl rand -base64 32
AUTH_SECRET=""

# Encrypts provider admin keys at rest (AES-256-GCM). Must decode to exactly 32 bytes.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored admin keys unreadable; customers must reconnect.
ENCRYPTION_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: password reset, budget, and digest emails. Without a key, messages are logged server-side.
# onboarding@resend.dev only delivers to the Resend account owner. Employee mail needs a verified domain.
# RESEND_API_KEY=""
# EMAIL_FROM="AI Spend Control <onboarding@resend.dev>"

# Bearer secret for POST /api/cron/sync. Leave unset locally; the route returns 401.
# openssl rand -base64 32
# CRON_SECRET=""
